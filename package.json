{
  "name": "neurocient-monorepo",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend run test",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "test:backend": "cd backend && .venv\\Scripts\\python.exe -m pytest",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "cd backend && python -m venv .venv && .venv\\Scripts\\python.exe -m pip install -r requirements.txt"
  }
}
