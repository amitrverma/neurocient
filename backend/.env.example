ENV=prod
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
JWT_SECRET=
OPENAI_API_KEY=

# Prefer the JSON value in a container. A filesystem path is useful locally.
FIREBASE_CREDENTIALS_JSON=
# FIREBASE_CREDENTIALS_PATH=

# Leave COOKIE_DOMAIN unset for host-only cookies.
# COOKIE_DOMAIN=.example.com

VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Protects manual notification-trigger endpoints under /api.
ADMIN_API_KEY=
ADMIN_EMAIL=hello@neurocient.com

# Modern Caveman cohort payments. Checkout remains disabled unless all are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Run this in only one replica until scheduling moves to a dedicated worker.
ENABLE_SCHEDULER=false
