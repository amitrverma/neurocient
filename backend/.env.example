ENV=dev
DATABASE_URL=postgresql+asyncpg://neurocient:neurocient_local@127.0.0.1:5432/neurocient
JWT_SECRET=
OPENAI_API_KEY=

# Prefer the JSON value in a container. A filesystem path is useful locally.
FIREBASE_CREDENTIALS_JSON=
# FIREBASE_CREDENTIALS_PATH=

# Leave COOKIE_DOMAIN unset for host-only cookies.
# COOKIE_DOMAIN=.example.com

VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Direct Meta WhatsApp Cloud API. Use the values shown in the Meta developer
# dashboard for the app/test number. WHATSAPP_VERIFY_TOKEN is a private random
# 32+ character value you create and enter in both this file and Meta's webhook
# settings; keep it different from WHATSAPP_APP_SECRET.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
# Separate key used only to hash short-lived WhatsApp ownership codes (32+ chars).
CONSENT_VERIFICATION_SECRET=

# Protects manual notification-trigger endpoints under /api.
ADMIN_API_KEY=
ADMIN_EMAIL=hello@neurocient.com

# Modern Caveman cohort payments. Checkout remains disabled unless all are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ₹499 INR/month membership subscriptions. Keep this webhook secret separate
# from the cohort payment webhook. TOTAL_COUNT is a deliberate commercial
# decision because Razorpay subscriptions are bounded.
RAZORPAY_MEMBERSHIP_PLAN_ID=
RAZORPAY_MEMBERSHIP_AMOUNT_MINOR=49900
RAZORPAY_MEMBERSHIP_CURRENCY=INR
RAZORPAY_MEMBERSHIP_TOTAL_COUNT=
RAZORPAY_MEMBERSHIP_WEBHOOK_SECRET=

# Password recovery. Use the public frontend reset route as the base URL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# Web processes ignore this setting. Set it to true only for the dedicated
# `python -m app.worker` process. Until that worker is deployed, reminders and
# reconciliation schedules remain paused.
ENABLE_SCHEDULER=false

# Durable abuse controls. Production requires true and two distinct secrets (32+ chars).
RATE_LIMIT_ENABLED=false
RATE_LIMIT_KEY_SECRET=
ABUSE_PROXY_SECRET=
CSRF_TRUSTED_ORIGINS=https://www.neurocient.com,https://neurocient.com
