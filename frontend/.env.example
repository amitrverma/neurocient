# Server-only URL used by Next.js route handlers to reach the backend.
# Override this with the deployed backend origin in Preview and Production.
API_BASE_URL=http://127.0.0.1:8000
ABUSE_PROXY_SECRET=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Membership and cohort checkout are created by the backend. Never expose
# Razorpay secrets in the frontend environment.

AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=
