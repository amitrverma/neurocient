# Server-only URL used by Next.js route handlers to reach the backend.
API_BASE_URL=https://api.example.com

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional hosted checkout. When unset, Membership uses assisted WhatsApp purchase.
MEMBERSHIP_CHECKOUT_URL=

# Modern Caveman cohort checkout is created by the backend. Never expose the secret.
# Configure RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, and RAZORPAY_WEBHOOK_SECRET there.

RESEND_API_KEY=
RESEND_FROM_EMAIL=

AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=
