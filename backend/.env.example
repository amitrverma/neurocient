ENV=dev
DATABASE_URL=postgresql+asyncpg://neurocient:neurocient_local@127.0.0.1:5432/neurocient
JWT_SECRET=
OPENAI_API_KEY=

# Prefer the JSON value in a container. A filesystem path is useful locally.
FIREBASE_CREDENTIALS_JSON=
# FIREBASE_CREDENTIALS_PATH=

# Leave COOKIE_DOMAIN unset for host-only cookies.
# COOKIE_DOMAIN=.example.com

VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Exact public URL configured in Twilio; used as signed input, including query string.
TWILIO_WHATSAPP_WEBHOOK_URL=https://api.neurocient.com/wa/webhook/whatsapp

# Protects manual notification-trigger endpoints under /api.
ADMIN_API_KEY=
ADMIN_EMAIL=hello@neurocient.com

# Modern Caveman cohort payments. Checkout remains disabled unless all are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Password recovery. Use the public frontend reset route as the base URL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# Run this in only one replica until scheduling moves to a dedicated worker.
ENABLE_SCHEDULER=false
