# Root ignores for the monorepo.

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
backend/.venv/

# Environment files
.env
.env.*
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*

# Editors and OS files
.DS_Store
Thumbs.db
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel/
frontend/.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts
